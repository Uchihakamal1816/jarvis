# ==========================================
# PROJECT JARVIS — ENVIRONMENT CONFIGURATION
# ==========================================

# ── AI Model API Keys ──────────────────────
# Google Antigravity SDK (Gemini Intelligence Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq LLM (Voice Response Improviser & Summarizer)
GROQ_API_KEY=your_groq_api_key_here

# Claude AI (Anthropic Integration / Collaboration)
ANTHROPIC_API_KEY=your_claude_api_key_here

# ── Voice Layer Pipeline ───────────────────
# Audio Sampling & Processing
SAMPLE_RATE=16000
AUDIO_DEVICE_INDEX=
AUDIO_SILENCE_SKIP_RMS=50

# Silero VAD (Voice Activity Detection)
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=500
VAD_SPEECH_PAD_MS=100
VAD_PADDING_MS=100
VAD_USE_ONNX=true

# Wake Word (openwakeword)
WAKE_WORD_ENABLED=true
WAKE_WORD_MODEL=hey_mycroft
WAKE_WORD_THRESHOLD=0.5

# Whisper STT (faster-whisper)
WHISPER_MODEL_NAME=small
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=4
MAX_UTTERANCE_MS=15000

# Text-to-Speech (Edge-TTS)
TTS_ENABLED=true
TTS_VOICE=en-GB-ThomasNeural
TTS_RATE=+0%

# Pipeline Output Mode (core = Hermes + Groq + TTS)
OUTPUT_MODE=core
WEBHOOK_URL=
WEBHOOK_TIMEOUT_S=5.0

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
